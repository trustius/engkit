{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engkit/pack.schema.json",
  "title": "engkit technology pack (pack.yaml)",
  "description": "Declarative, data-only pack. Documentation schema; src/engkit/packs.py is authoritative.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "description",
    "profile_schema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "pack"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Must equal the pack directory name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profile_schema": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      }
    },
    "applies_to": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incompatible_stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detect": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "Project-relative POSIX path; no absolute paths, '..' or empty segments.",
              "not": {
                "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
              }
            },
            "description": "Exact file names relative to the candidate directory; no globs."
          },
          "component": {
            "type": "boolean",
            "description": "A match marks the directory as a component root."
          },
          "parse": {
            "enum": [
              "json",
              "yaml",
              "toml"
            ]
          },
          "key": {
            "type": "string",
            "description": "Dotted key that must exist (requires parse)."
          },
          "stack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runtimes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "frameworks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "datastores": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "build_tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "package_managers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "commands": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "argv"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "description": "May contain the placeholder {package_manager}."
                },
                "status": {
                  "enum": [
                    "unknown",
                    "documented",
                    "inferred",
                    "verified",
                    "ambiguous"
                  ]
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Project-relative POSIX path; no absolute paths, '..' or empty segments.",
        "not": {
          "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
        }
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Project-relative POSIX path; no absolute paths, '..' or empty segments.",
        "not": {
          "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
        }
      },
      "description": "string.Template text; placeholders: component_id, component_root, pack_id, pack_version, project_name."
    }
  }
}
