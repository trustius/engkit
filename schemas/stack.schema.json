{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engkit/stack.schema.json",
  "title": "engkit stack definition (stacks/<id>.yaml)",
  "description": "Documentation schema; src/engkit/profiles.py is authoritative.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "stack"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "existing",
            "new"
          ],
          "default": "existing"
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "object",
          "description": "Free-form scalar or list-of-scalar constraints; no field is mandatory."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/command"
          }
        },
        "conventions": {
          "$ref": "#/$defs/conventions"
        },
        "packs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pack_ref"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Argument vector; rendered, never executed, never passed to a shell."
        },
        "cwd": {
          "type": "string",
          "description": "Project-relative POSIX path; no absolute paths, '..' or empty segments.",
          "not": {
            "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
          }
        },
        "status": {
          "enum": [
            "unknown",
            "documented",
            "inferred",
            "verified",
            "ambiguous"
          ]
        },
        "source": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "pack_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Exact version pin."
            }
          }
        }
      ]
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Project-relative POSIX path; no absolute paths, '..' or empty segments.",
            "not": {
              "pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "component": {
